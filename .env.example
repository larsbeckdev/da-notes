# Vorlage für den Docker-Stack.
#
#   cp .env.example .env
#
# Docker Compose liest .env im Projektverzeichnis automatisch ein.
# Die .env selbst ist per .gitignore ausgeschlossen und gehört NICHT ins
# Repository. Hier stehen nur Platzhalter, niemals echte Werte.

# --- Ports auf dem Host ---------------------------------------------------
# Bei geändertem BACKEND_PORT auch die apiUrl in
# frontend/src/environments/environment.development.ts anpassen.
BACKEND_PORT=8000
FRONTEND_PORT=4200

# --- Django ---------------------------------------------------------------
# Signiert Sessions und CSRF-Tokens. Muss geheim bleiben.
# Neuen Key erzeugen:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=hier-einen-eigenen-key-eintragen

# Debug-Modus. In Produktion zwingend auf 0.
DJANGO_DEBUG=1

# Erlaubte Hosts, kommagetrennt.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Origins, die per CORS auf die API zugreifen dürfen.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

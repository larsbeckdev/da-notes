# Template for the Docker stack.
#
#   cp .env.example .env
#
# Docker Compose reads .env in the project directory automatically.
# The .env itself is excluded via .gitignore and does NOT belong in the
# repository. Only placeholders here, never real values.

# --- Host ports -----------------------------------------------------------
# When BACKEND_PORT changes, also adjust the apiUrl in
# frontend/src/environments/environment.development.ts.
BACKEND_PORT=8000
FRONTEND_PORT=4200

# --- Django ---------------------------------------------------------------
# Signs sessions and CSRF tokens. Must stay secret.
# Generate a new key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=put-your-own-key-here

# Debug mode. Must be 0 in production.
DJANGO_DEBUG=1

# Allowed hosts, comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Origins allowed to call the API via CORS.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Public HTTPS addresses behind the reverse proxy. Without an entry the CSRF
# check fails on POST/PUT/DELETE through the domain.
CSRF_TRUSTED_ORIGINS=https://da-notes.larsbeck.dev

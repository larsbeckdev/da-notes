# Vorlage für lokale Umgebungsvariablen.
# Kopieren nach .env und anpassen. Die .env selbst ist per .gitignore ausgeschlossen.
#
# Hinweis: Django liest diese Datei nicht automatisch ein. Entweder die Variablen
# in der Shell setzen, oder python-dotenv installieren und in settings.py laden.
# Für den Docker-Betrieb sind die Werte bereits in compose.yml gesetzt.

# Debug-Modus. In Produktion auf 0 setzen.
DJANGO_DEBUG=1

# Erlaubte Hosts, kommagetrennt.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Pfad zur SQLite-Datei. Leer lassen für den Default (backend/db.sqlite3).
DJANGO_DB_PATH=

# Origins, die per CORS auf die API zugreifen dürfen (Angular-Dev-Server).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Template for local environment variables.
#
#   cp .env.example .env
#
# .env and .env.local are excluded via .gitignore and do NOT belong in the
# repository. Only placeholders here, never real values.
#
# .env is loaded first, then .env.local (which overrides .env).
# For Docker operation the values come from compose.yml.

# Signs sessions and CSRF tokens. Must stay secret.
# Generate a new key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=put-your-own-key-here

# Debug mode. Must be 0 in production.
DJANGO_DEBUG=1

# Allowed hosts, comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Path to the SQLite file. Leave empty for the default (backend/db.sqlite3).
DJANGO_DB_PATH=

# Origins allowed to call the API via CORS (Angular dev server).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

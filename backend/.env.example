# Vorlage für lokale Umgebungsvariablen.
#
#   cp .env.example .env
#
# .env und .env.local sind per .gitignore ausgeschlossen und gehören NICHT
# ins Repository. Hier stehen nur Platzhalter, niemals echte Werte.
#
# Geladen wird zuerst .env, danach .env.local (überschreibt .env).
# Für den Docker-Betrieb kommen die Werte aus compose.yml.

# Signiert Sessions und CSRF-Tokens. Muss geheim bleiben.
# Neuen Key erzeugen:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=hier-einen-eigenen-key-eintragen

# Debug-Modus. In Produktion zwingend auf 0.
DJANGO_DEBUG=1

# Erlaubte Hosts, kommagetrennt.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Pfad zur SQLite-Datei. Leer lassen für den Default (backend/db.sqlite3).
DJANGO_DB_PATH=

# Origins, die per CORS auf die API zugreifen dürfen (Angular-Dev-Server).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
